# Scandex x Cantor8 environment (DevNet).
#
# Copy to .env and fill in locally. .env is gitignored; NEVER commit real
# secrets. C8_CLIENT_SECRET must be supplied per session and is never written
# down in the repo. Real shell environment variables override this file.

# --- required for DevNet ---
C8_BASE=https://api.validator.dev.digik.cantor8.tech/api/ledger
C8_IDP=https://auth.dev.digik.cantor8.tech
C8_CLIENT_ID=hackathon
C8_CLIENT_SECRET=<enter-secret-locally>
C8_REGISTRY=https://sv-proxy.dev.digik.cantor8.tech

# --- optional ---
# C8_USER=ledger-api-user               # ledger API user id in the token sub
# C8_PARTY=<your-party-id>              # the party this run is about
# C8_ADMIN_PARTY=<admin-or-dso-party>  # admin/DSO party override (needed for transfer preview)
# C8_REGISTRY_HOST=scan.localhost      # only when the registry routes by Host header
# C8_SCANNER_BASE=https://scanner-ledger-read-api.dev.digik.cantor8.tech
# C8_SCAN_BASE=https://sv-proxy.dev.digik.cantor8.tech   # public Scan API, no auth
# C8_TIMEOUT=30                        # per-request timeout in seconds
