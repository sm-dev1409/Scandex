# Base URL of the Scandex local JSON API (webapi.py / scripts/serve_api.py).
#
# Copy this file to .env.local and edit it to point the frontend at a
# different server. .env.local is gitignored (scanner-frontend/.gitignore
# ignores "*.local"), so your local override is never committed.
#
# Defaults to http://127.0.0.1:8787 when unset — the port webapi.py's
# build_parser() actually defaults to. Note 127.0.0.1 rather than localhost:
# the backend binds 127.0.0.1, and on some systems "localhost" resolves to ::1
# first, where nothing is listening.
#
# This is a BUILD-TIME value: Vite inlines import.meta.env at build time, so
# restart `npm run dev` (or re-run `npm run build`) after changing it.
#
# Test-mode server on an alternate port, for example:
#   VITE_API_BASE=http://127.0.0.1:8790
VITE_API_BASE=http://127.0.0.1:8787
